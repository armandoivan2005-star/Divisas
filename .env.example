DJANGO_SECRET_KEY=replace-with-random-secure-key
DEBUG=0
LANGUAGE_CODE=es-mx
TIME_ZONE=America/Mexico_City
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_ENGINE=sqlite
SQLITE_DB_NAME=db.sqlite3
# Para PostgreSQL local:
# DB_ENGINE=postgresql
# DB_NAME=practica01
# DB_USER=postgres
# DB_PASSWORD=replace-db-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_DISABLE_SERVER_SIDE_CURSORS=0
# DB_DISABLE_PREPARED_STATEMENTS=0

# Supabase (recomendado para Django persistente en una red IPv4):
# Dashboard de Supabase > Connect > Session pooler.
# Copia exactamente host y usuario; el usuario suele ser postgres.PROJECT_REF.
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres.PROJECT_REF
# DB_PASSWORD=replace-with-supabase-database-password
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require
# DB_SCHEMA=django_app
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_DISABLE_SERVER_SIDE_CURSORS=0
# DB_DISABLE_PREPARED_STATEMENTS=0

# Solo para despliegues serverless: usa Transaction pooler (puerto 6543),
# DB_CONN_MAX_AGE=0 y activa las dos opciones siguientes.
# DB_DISABLE_SERVER_SIDE_CURSORS=1
# DB_DISABLE_PREPARED_STATEMENTS=1

TWELVEDATA_API_KEY=replace-api-key
ALERT_EMAILS_ENABLED=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=replace@email.com
EMAIL_HOST_PASSWORD=replace-email-app-password
DEFAULT_FROM_EMAIL=Panel Divisas <replace@email.com>

SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURITY_LOG_LEVEL=INFO
